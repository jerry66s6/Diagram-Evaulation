{
  "models": {
    "expectation": "gpt-5.6",
    "openai": ["gpt-5.5", "gpt-5.6"],
    "anthropic": "claude-opus-4-8"
  },
  "vfig": {
    "command": [
      "python",
      "/absolute/path/to/VFig/inference/inference.py",
      "{image}",
      "--output",
      "{svg}"
    ],
    "timeout_seconds": 600
  },
  "geometry": {
    "position_tolerance": 0.06,
    "size_tolerance": 0.25,
    "endpoint_tolerance": 0.08,
    "minimum_font_size": 12.0,
    "overlap_area_threshold": 0.01,
    "match_threshold": 0.5
  },
  "severity_multipliers": {
    "low": 1.0,
    "medium": 2.0,
    "high": 4.0,
    "critical": 8.0
  },
  "fallback_frequencies": {
    "presence": 1.0,
    "layout": 1.0,
    "connectivity": 1.0,
    "details": 1.0,
    "legibility": 1.0
  },
  "weight_history": "config/issue_history.json"
}

